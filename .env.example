# MariaDB Connection settings
host=127.0.0.1
user=db_user
password=your_db_password
database=lionsaddr

# SQLAlchemy async DB URL (mysql+asyncmy://user:password@host:port/database?charset=utf8mb4)
dburl=mysql+asyncmy://db_user:your_db_password@127.0.0.1:3306/lionsaddr?charset=utf8mb4

# Secret Keys
SESSION_SECRET_KEY=change_this_to_a_long_random_session_secret_key
JWT_SECRET_KEY=change_this_to_a_long_random_jwt_secret_key

